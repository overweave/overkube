{
  "name": "overkube",
  "version": "0.0.0",
  "private": true,
  "description": "A dashboard for Kubernetes clusters, built on overweave: its pieces are addons, layered over one another",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overkube.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "addons/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "[ \"$(npm query .workspace)\" = \"[]\" ] || npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --passWithNoTests --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  }
}

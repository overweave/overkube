{
  "name": "@overkube/sdk",
  "version": "0.0.0-dev",
  "description": "What overkube's addons are written with: the dashboard's kinds over overweave (KindView, Category, Column, Field, TableView, Page, Action), its slots, defineAddon and what an addon is given — its contributor and the cluster (queries, live); hooks for its components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overkube.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/overweave/overkube/tree/main/packages/sdk#readme",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preact": {
      "overkube-source": "./src/preact/index.ts",
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@overkube/gateway": "0.0.0-dev",
    "@overkube/kube-types": "0.0.0-dev",
    "@overkube/query": "0.0.0-dev",
    "@overkube/uikit": "0.0.0-dev",
    "@overweave/core": "0.5.0",
    "@overweave/ui": "0.5.0"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@overkube/source": "0.0.0-dev",
    "@overkube/testkit": "0.0.0-dev",
    "@overweave/testkit": "0.5.0",
    "@preact/signals": "2.11.3",
    "@testing-library/preact": "3.2.6",
    "happy-dom": "20.14.6",
    "preact": "10.29.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@overkube/shell",
  "version": "0.0.0-dev",
  "private": true,
  "description": "overkube's frame, drawn wherever the page is — the page itself, a test, a story: its header, navigation and overlay slots, the Page at the path (a hash's, or one held in memory) and the resource opened over it, the user told things",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@overkube/kube-types": "0.0.0-dev",
    "@overkube/query": "0.0.0-dev",
    "@overkube/sdk": "0.0.0-dev",
    "@overkube/uikit": "0.0.0-dev",
    "@overweave/core": "0.5.0",
    "@overweave/ui": "0.5.0"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/signals": "2.11.3",
    "@testing-library/preact": "3.2.4",
    "happy-dom": "21.0.4",
    "preact": "10.29.8"
  }
}

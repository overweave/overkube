{
  "name": "@overkube/storybook",
  "version": "0.0.0-dev",
  "private": true,
  "description": "overkube's addons in Storybook: the whole page at a path, the addons beside one another (turned off and on in overweave's panel), a cluster in memory with what the story gives it, the user's own changes",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preact": {
      "overkube-source": "./src/preact/index.ts",
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@overkube/kube-types": "0.0.0-dev",
    "@overkube/sdk": "0.0.0-dev",
    "@overkube/shell": "0.0.0-dev",
    "@overkube/testkit": "0.0.0-dev",
    "@overkube/uikit": "0.0.0-dev",
    "@overweave/storybook": "0.5.0"
  },
  "peerDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@storybook/preact-vite": "^10.6.2",
    "preact": "^10.29.8",
    "storybook": "^10.6.0",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "@preact/preset-vite": {
      "optional": true
    },
    "@storybook/preact-vite": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@overkube/addon-core": "0.0.0-dev",
    "@testing-library/preact": "3.2.4",
    "happy-dom": "20.14.6",
    "preact": "10.29.8"
  }
}

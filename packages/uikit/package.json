{
  "name": "@overkube/uikit",
  "version": "0.0.0-dev",
  "description": "overkube's UI kit: the components and styles its page and its addons are drawn with",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overkube.git",
    "directory": "packages/uikit"
  },
  "homepage": "https://github.com/overweave/overkube/tree/main/packages/uikit#readme",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && cp ../../LICENSE .",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "elkjs": "0.12.0"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@storybook/preact-vite": "10.6.1",
    "@tabler/icons": "3.49.0",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.7",
    "happy-dom": "20.14.6",
    "preact": "10.29.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

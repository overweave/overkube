{
  "name": "@overkube/uikit",
  "version": "0.0.0-dev",
  "description": "overkube's UI kit: the components and styles its page and its addons are drawn with",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overkube.git",
    "directory": "packages/uikit"
  },
  "homepage": "https://github.com/overweave/overkube/tree/main/packages/uikit#readme",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && cp ../../LICENSE .",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "elkjs": "0.12.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@storybook/preact-vite": "10.6.3",
    "@tabler/icons": "3.49.0",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "14.6.8",
    "happy-dom": "20.14.6",
    "preact": "10.29.8"
  },
  "publishConfig": {
    "access": "public"
  }
}

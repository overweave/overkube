{
  "name": "@overkube/gateway",
  "version": "0.0.0-dev",
  "description": "overkube's way to a Kubernetes cluster: the API server's paths passed on, several watches over one stream, changes as JSON, a status — one handler over Node's request and response, for any host",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overweave/overkube.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/overweave/overkube/tree/main/packages/gateway#readme",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "overkube-source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@overkube/query": "0.0.0-dev",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@overkube/kube-fields",
  "version": "0.0.0-dev",
  "private": true,
  "description": "The fields every Kubernetes object has to ask by, as data: paths and CEL of the built-in kinds, and those a CRD declares — the same for the page and a server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",

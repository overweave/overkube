      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@overkube/cel": "0.0.0-dev",
    "@overkube/query": "0.0.0-dev"
  },
  "devDependencies": {
    "@overkube/kube-types": "0.0.0-dev"
  }
}

{
  "name": "@overkube/source",
  "version": "0.0.0-dev",
  "private": true,
  "description": "overkube's answers to queries (@overkube/query) from the cluster's data: a live query planned onto feeds (@overkube/connector), its fields per kind (kube-fields, a CRD's columns), answered by a scan as they change",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "overkube-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@overkube/cel": "0.0.0-dev",
    "@overkube/connector": "0.0.0-dev",
    "@overkube/kube-fields": "0.0.0-dev",
    "@overkube/kube-types": "0.0.0-dev",
    "@overkube/query": "0.0.0-dev"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.2"
  },
  "devDependencies": {
    "@overkube/fake-kube": "0.0.0-dev",
    "@overkube/gateway": "0.0.0-dev",
    "@preact/signals": "2.11.3",
    "@types/node": "24.10.1"
  }
}
